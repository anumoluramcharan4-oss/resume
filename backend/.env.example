# ==========================================
# AI Career Growth Platform — Environment Variables Example
# ==========================================

# Server port
PORT=5001

# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/careergrowth
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/careergrowth
MONGO_URI=mongodb://localhost:27017/careergrowth

# JWT Secret — change this to a long random string in production
JWT_SECRET=your_jwt_secret_here

# JWT Expiry
JWT_EXPIRE=7d

# OpenRouter API Key (Primary AI Gateway - routes to Gemini, Qwen, Llama, etc.)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model (OpenRouter model ID, default: nex-agi/nex-n2-pro:free)
# AI_MODEL=nex-agi/nex-n2-pro:free

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
